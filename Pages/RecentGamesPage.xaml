<Page x:Class="ScrimStasis.Pages.RecentGamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ScrimStasis.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RecentGamesPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="16,16,16,0">
            <Button Content="Import saved game" Click="ImportJson_Click" Padding="10,4"/>
        </StackPanel>

        <ListBox x:Name="RecentGamesList" Grid.Row="1"
                 ItemsSource="{Binding Games}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="GamesList_SelectionChanged"
                 Margin="16">

        <ListBox.ItemTemplate >
            <DataTemplate>
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Width="56" Height="56"
                           Source="{Binding ChampionIconUrl}"/>

                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Result}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GameMode}" Opacity="0.7"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Kda}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Duration}" Opacity="0.7" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
    </Grid>
</Page>
